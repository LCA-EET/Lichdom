//{ Crown of the Lich Undead Flag
IF
	!Race(Player1, LICH)
	HasItemEquiped("xaldcrwn", Player1)
	!General(Player1, UNDEAD)
	TriggerOverride(Player1, GlobalLT("XA_LC_AssignGeneral", "LOCALS", 1))
THEN
	RESPONSE #100
		ActionOverride(Player1, SetGlobal("XA_LC_AssignGeneral", "LOCALS", 1))
		Continue()
END

/* 
	Record the characters original General attribute
	Humanoid = 1
	Animal = 3
	GiantHumanoid = 4
	Plant = 5
	Monster = 6

*/
IF
	TriggerOverride(Player1, Global("XA_LC_AssignGeneral", "LOCALS", 1))
	General(Player1, HUMANOID)
THEN
	RESPONSE #100
		ActionOverride(Player1, SetGlobal("XA_LC_AssignGeneral", "LOCALS", 2))
		ActionOverride(Player1, SetGlobal("XA_LC_PriorGeneral", "LOCALS", 1))
		Continue()
END

IF
	TriggerOverride(Player1, Global("XA_LC_AssignGeneral", "LOCALS", 1))
	General(Player1, ANIMAL)
THEN
	RESPONSE #100
		ActionOverride(Player1, SetGlobal("XA_LC_AssignGeneral", "LOCALS", 2))
		ActionOverride(Player1, SetGlobal("XA_LC_PriorGeneral", "LOCALS", 3))
		Continue()
END

IF
	TriggerOverride(Player1, Global("XA_LC_AssignGeneral", "LOCALS", 1))
	General(Player1, GIANTHUMANOID)
THEN
	RESPONSE #100
		ActionOverride(Player1, SetGlobal("XA_LC_AssignGeneral", "LOCALS", 2))
		ActionOverride(Player1, SetGlobal("XA_LC_PriorGeneral", "LOCALS", 4))
		Continue()
END

IF
	TriggerOverride(Player1, Global("XA_LC_AssignGeneral", "LOCALS", 1))
	General(Player1, PLANT)
THEN
	RESPONSE #100
		ActionOverride(Player1, SetGlobal("XA_LC_AssignGeneral", "LOCALS", 2))
		ActionOverride(Player1, SetGlobal("XA_LC_PriorGeneral", "LOCALS", 5))
		Continue()
END

IF
	TriggerOverride(Player1, Global("XA_LC_AssignGeneral", "LOCALS", 1))
	General(Player1, MONSTER)
THEN
	RESPONSE #100
		ActionOverride(Player1, SetGlobal("XA_LC_AssignGeneral", "LOCALS", 2))
		ActionOverride(Player1, SetGlobal("XA_LC_PriorGeneral", "LOCALS", 6))
		Continue()
END

IF
	TriggerOverride(Player1, Global("XA_LC_AssignGeneral", "LOCALS", 2))
THEN
	RESPONSE #100
		ActionOverride(Player1, SetGlobal("XA_LC_AssignGeneral", "LOCALS", 0))
		ChangeGeneral(Player1, UNDEAD)
		Continue()
END

// Reset the character's original General attribute

IF
	!Race(Player1, LICH)
	!HasItemEquiped("xaldcrwn", Player1)
	General(Player1, UNDEAD)
	TriggerOverride(Player1, Global("XA_LC_PriorGeneral", "LOCALS", 1))
THEN
	RESPONSE #100
		ChangeGeneral(Player1, HUMANOID)
		Continue()
END

IF
	!Race(Player1, LICH)
	!HasItemEquiped("xaldcrwn", Player1)
	General(Player1, UNDEAD)
	TriggerOverride(Player1, Global("XA_LC_PriorGeneral", "LOCALS", 3))
THEN
	RESPONSE #100
		ChangeGeneral(Player1, ANIMAL)
		Continue()
END

IF
	!Race(Player1, LICH)
	!HasItemEquiped("xaldcrwn", Player1)
	General(Player1, UNDEAD)
	TriggerOverride(Player1, Global("XA_LC_PriorGeneral", "LOCALS", 4))
THEN
	RESPONSE #100
		ChangeGeneral(Player1, GIANTHUMANOID)
		Continue()
END

IF
	!Race(Player1, LICH)
	!HasItemEquiped("xaldcrwn", Player1)
	General(Player1, UNDEAD)
	TriggerOverride(Player1, Global("XA_LC_PriorGeneral", "LOCALS", 5))
THEN
	RESPONSE #100
		ChangeGeneral(Player1, PLANT)
		Continue()
END

IF
	!Race(Player1, LICH)
	!HasItemEquiped("xaldcrwn", Player1)
	General(Player1, UNDEAD)
	TriggerOverride(Player1, Global("XA_LC_PriorGeneral", "LOCALS", 6))
THEN
	RESPONSE #100
		ChangeGeneral(Player1, MONSTER)
		Continue()
END
//}

